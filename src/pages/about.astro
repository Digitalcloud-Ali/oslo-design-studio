---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - Oslo Design Studio">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>About Us</h1>
      <p>Passionate designers creating exceptional experiences since 2015</p>
    </div>
  </section>

  <!-- Story Section -->
  <section class="section story-section">
    <div class="container">
      <div class="story-content">
        <div class="story-text">
          <h2 class="section-title">Our Story</h2>
          <p>Founded in 2015 in the heart of Oslo, Oslo Design Studio began with a simple mission: to create design that matters. What started as a small team of three passionate designers has grown into a full-service creative agency serving clients across Norway and Scandinavia.</p>
          <p>We believe that great design is more than just aesthetics—it's about solving problems, telling stories, and creating experiences that resonate with people. Every project we undertake is an opportunity to push creative boundaries while delivering measurable results for our clients.</p>
          <p>Today, our team of talented designers, developers, and strategists works with businesses of all sizes, from ambitious startups to established enterprises, helping them build memorable brands and digital experiences that drive growth.</p>
        </div>
        <div class="story-image">
          <div class="image-placeholder" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="image-overlay">
              <p>Oslo Design Studio Team</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="section values-section">
    <div class="container">
      <h2 class="section-title">Our Values</h2>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">🎯</div>
          <h3>Purpose-Driven</h3>
          <p>We create designs that serve a purpose and solve real problems for businesses and their customers.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">💡</div>
          <h3>Innovation</h3>
          <p>We stay ahead of design trends and technology, constantly exploring new ways to create exceptional work.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">🤝</div>
          <h3>Collaboration</h3>
          <p>We work closely with our clients as partners, involving them throughout the creative process.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">⚡</div>
          <h3>Excellence</h3>
          <p>We're committed to delivering high-quality work that exceeds expectations on every project.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">🌱</div>
          <h3>Sustainability</h3>
          <p>We consider the environmental impact of our work and strive for sustainable design practices.</p>
        </div>
        <div class="value-card">
          <div class="value-icon">🎨</div>
          <h3>Creativity</h3>
          <p>We bring fresh perspectives and creative thinking to every challenge we tackle.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="section team-section">
    <div class="container">
      <h2 class="section-title">Meet Our Team</h2>
      <p class="team-intro">A diverse group of talented individuals passionate about design and innovation</p>
      <div class="team-grid">
        <div class="team-member">
          <div class="member-photo" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="photo-overlay">ES</div>
          </div>
          <h3>Erik Sørensen</h3>
          <p class="member-role">Creative Director & Co-Founder</p>
          <p class="member-bio">With 15+ years of experience, Erik leads our creative vision and ensures every project meets the highest standards.</p>
        </div>
        <div class="team-member">
          <div class="member-photo" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
            <div class="photo-overlay">SA</div>
          </div>
          <h3>Sofie Andersen</h3>
          <p class="member-role">Lead Designer & Co-Founder</p>
          <p class="member-bio">Sofie's passion for user-centered design drives our approach to creating intuitive digital experiences.</p>
        </div>
        <div class="team-member">
          <div class="member-photo" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);">
            <div class="photo-overlay">LJ</div>
          </div>
          <h3>Lars Johansen</h3>
          <p class="member-role">Technical Director & Co-Founder</p>
          <p class="member-bio">Lars brings designs to life with cutting-edge development and technical expertise.</p>
        </div>
        <div class="team-member">
          <div class="member-photo" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%);">
            <div class="photo-overlay">MH</div>
          </div>
          <h3>Maria Hansen</h3>
          <p class="member-role">Brand Strategist</p>
          <p class="member-bio">Maria helps clients define and communicate their brand story effectively across all touchpoints.</p>
        </div>
        <div class="team-member">
          <div class="member-photo" style="background: linear-gradient(135deg, #30cfd0 0%, #330867 100%);">
            <div class="photo-overlay">JN</div>
          </div>
          <h3>Jonas Nielsen</h3>
          <p class="member-role">UI/UX Designer</p>
          <p class="member-bio">Jonas crafts beautiful interfaces that are both visually stunning and incredibly functional.</p>
        </div>
        <div class="team-member">
          <div class="member-photo" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">
            <div class="photo-overlay">KL</div>
          </div>
          <h3>Kristine Larsen</h3>
          <p class="member-role">Digital Marketing Specialist</p>
          <p class="member-bio">Kristine develops strategies that amplify our clients' messages and drive engagement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Awards Section -->
  <section class="section awards-section">
    <div class="container">
      <h2 class="section-title">Awards & Recognition</h2>
      <div class="awards-grid">
        <div class="award-item">
          <div class="award-year">2024</div>
          <h3>Best Digital Agency - Norway</h3>
          <p>Norwegian Design Awards</p>
        </div>
        <div class="award-item">
          <div class="award-year">2023</div>
          <h3>Excellence in Web Design</h3>
          <p>Scandinavian Design Forum</p>
        </div>
        <div class="award-item">
          <div class="award-year">2023</div>
          <h3>Innovation in Branding</h3>
          <p>Nordic Marketing Association</p>
        </div>
        <div class="award-item">
          <div class="award-year">2022</div>
          <h3>Agency of the Year - Oslo</h3>
          <p>Oslo Business Chamber</p>
        </div>
        <div class="award-item">
          <div class="award-year">2022</div>
          <h3>Best User Experience Design</h3>
          <p>European Design Awards</p>
        </div>
        <div class="award-item">
          <div class="award-year">2021</div>
          <h3>Creative Excellence</h3>
          <p>Norwegian Advertising Association</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Want to Work With Us?</h2>
      <p>We're always excited to take on new challenges and partner with ambitious businesses</p>
      <a href="/contact" class="btn">Get in Touch</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 6rem 2rem 4rem;
    text-align: center;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .page-header p {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  /* Story Section */
  .story-section {
    background: white;
  }

  .story-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .story-text {
    max-width: 600px;
  }

  .story-text h2 {
    text-align: left;
    margin-bottom: 2rem;
  }

  .story-text p {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 1.5rem;
    color: var(--text-color);
  }

  .image-placeholder {
    height: 500px;
    border-radius: 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .image-overlay {
    color: white;
    font-size: 1.5rem;
    font-weight: 600;
    text-align: center;
    padding: 2rem;
  }

  /* Values Section */
  .values-section {
    background: var(--light-bg);
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .value-card {
    background: white;
    padding: 2.5rem;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    text-align: center;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .value-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .value-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
  }

  .value-card h3 {
    color: var(--primary-color);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .value-card p {
    color: var(--dark-gray);
    line-height: 1.6;
  }

  /* Team Section */
  .team-section {
    background: white;
  }

  .team-intro {
    text-align: center;
    font-size: 1.1rem;
    color: var(--dark-gray);
    margin-bottom: 3rem;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 3rem;
  }

  .team-member {
    text-align: center;
  }

  .member-photo {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    transition: transform 0.3s;
  }

  .member-photo:hover {
    transform: scale(1.05);
  }

  .photo-overlay {
    color: white;
    font-size: 3rem;
    font-weight: bold;
  }

  .team-member h3 {
    color: var(--primary-color);
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .member-role {
    color: var(--secondary-color);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .member-bio {
    color: var(--dark-gray);
    line-height: 1.6;
  }

  /* Awards Section */
  .awards-section {
    background: var(--light-bg);
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .award-item {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    border-left: 4px solid var(--secondary-color);
    box-shadow: 0 5px 15px rgba(0,0,0,0.08);
    transition: transform 0.3s;
  }

  .award-item:hover {
    transform: translateX(10px);
  }

  .award-year {
    color: var(--secondary-color);
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .award-item h3 {
    color: var(--primary-color);
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .award-item p {
    color: var(--dark-gray);
  }

  /* CTA Section */
  .cta-section {
    background: var(--primary-color);
    color: white;
    text-align: center;
    padding: 4rem 2rem;
  }

  .cta-section h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .cta-section p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .page-header p {
      font-size: 1rem;
    }

    .story-content {
      grid-template-columns: 1fr;
    }

    .image-placeholder {
      height: 300px;
    }

    .member-photo {
      width: 150px;
      height: 150px;
    }

    .photo-overlay {
      font-size: 2rem;
    }

    .cta-section h2 {
      font-size: 2rem;
    }
  }
</style>
