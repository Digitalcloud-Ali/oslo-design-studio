---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Kontakt Oss - Oslo Design Studio">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Ta Kontakt</h1>
      <p>La oss diskutere hvordan vi kan hjelpe deg med å realisere din visjon</p>
    </div>
  </section>

  <!-- Contact Content -->
  <section class="section contact-section">
    <div class="container">
      <div class="contact-grid">
        <!-- Contact Form -->
        <div class="contact-form-container">
          <h2>Send Oss en Melding</h2>
          <p class="form-intro">Fyll ut skjemaet nedenfor så tar vi kontakt innen 24 timer.</p>
          
          <form class="contact-form" id="contactForm">
            <div class="form-group">
              <label for="name">Fullt Navn *</label>
              <input type="text" id="name" name="name" required placeholder="Ditt navn">
            </div>

            <div class="form-group">
              <label for="email">E-postadresse *</label>
              <input type="email" id="email" name="email" required placeholder="din.epost@eksempel.no">
            </div>

            <div class="form-group">
              <label for="phone">Telefonnummer</label>
              <input type="tel" id="phone" name="phone" placeholder="+47 123 45 678">
            </div>

            <div class="form-group">
              <label for="company">Firmanavn</label>
              <input type="text" id="company" name="company" placeholder="Ditt firma">
            </div>

            <div class="form-group">
              <label for="service">Interessert i Tjeneste *</label>
              <select id="service" name="service" required>
                <option value="">Velg en tjeneste</option>
                <option value="branding">Merkevareidentitet & Strategi</option>
                <option value="web">Webdesign & Utvikling</option>
                <option value="ui-ux">UI/UX Design</option>
                <option value="marketing">Digital Markedsføring</option>
                <option value="motion">Motion Graphics & Video</option>
                <option value="consulting">Konsulentbistand & Strategi</option>
                <option value="other">Annet</option>
              </select>
            </div>

            <div class="form-group">
              <label for="budget">Prosjektbudsjett (NOK)</label>
              <select id="budget" name="budget">
                <option value="">Velg budsjettramme</option>
                <option value="under-50k">Under 50 000</option>
                <option value="50k-100k">50 000 - 100 000</option>
                <option value="100k-200k">100 000 - 200 000</option>
                <option value="200k-500k">200 000 - 500 000</option>
                <option value="over-500k">Over 500 000</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Prosjektdetaljer *</label>
              <textarea id="message" name="message" rows="6" required placeholder="Fortell oss om ditt prosjekt, mål, tidslinje, osv."></textarea>
            </div>

            <div class="form-group checkbox-group">
              <label>
                <input type="checkbox" name="newsletter" id="newsletter">
                <span>Abonner på vårt nyhetsbrev for designtips og oppdateringer</span>
              </label>
            </div>

            <button type="submit" class="btn btn-submit">Send Melding</button>
            
            <div class="form-message" id="formMessage"></div>
          </form>
        </div>

        <!-- Contact Information -->
        <div class="contact-info">
          <div class="info-card">
            <h3>Besøk Vårt Studio</h3>
            <div class="info-item">
              <div class="info-icon">📍</div>
              <div>
                <strong>Adresse</strong>
                <p>Bogstadveien 27<br/>0355 Oslo, Norge</p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">🕐</div>
              <div>
                <strong>Åpningstider</strong>
                <p>Mandag - Fredag: 9:00 - 17:00<br/>Helg: Etter avtale</p>
              </div>
            </div>
          </div>

          <div class="info-card">
            <h3>Kontaktinformasjon</h3>
            <div class="info-item">
              <div class="info-icon">📧</div>
              <div>
                <strong>E-post</strong>
                <p><a href="mailto:hello@oslodesign.no">hello@oslodesign.no</a></p>
              </div>
            </div>
            <div class="info-item">
              <div class="info-icon">📞</div>
              <div>
                <strong>Telefon</strong>
                <p><a href="tel:+4722123456">+47 22 12 34 56</a></p>
              </div>
            </div>
          </div>

          <div class="info-card">
            <h3>Følg Oss</h3>
            <div class="social-links-vertical">
              <a href="#" class="social-link">
                <span class="social-icon">📷</span>
                <span>Instagram</span>
              </a>
              <a href="#" class="social-link">
                <span class="social-icon">💼</span>
                <span>LinkedIn</span>
              </a>
              <a href="#" class="social-link">
                <span class="social-icon">🎨</span>
                <span>Behance</span>
              </a>
              <a href="#" class="social-link">
                <span class="social-icon">🐦</span>
                <span>Twitter</span>
              </a>
            </div>
          </div>

          <div class="info-card map-card">
            <div class="map-placeholder">
              <div class="map-overlay">
                <p>📍 Finn oss i sentrum av Oslo</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="section faq-section">
    <div class="container">
      <h2 class="section-title">Ofte Stilte Spørsmål</h2>
      <div class="faq-grid">
        <div class="faq-item">
          <h3>Hva er deres typiske prosjekttidslinje?</h3>
          <p>Prosjekttidslinjer varierer basert på omfang og kompleksitet. Et typisk merkevareprosjekt tar 4-6 uker, mens et komplett nettsted kan ta 8-12 uker. Vi vil gi en detaljert tidslinje under vår første konsultasjon.</p>
        </div>
        <div class="faq-item">
          <h3>Jobber dere med internasjonale klienter?</h3>
          <p>Ja! Selv om vi er basert i Oslo, jobber vi med klienter over hele Norge, Skandinavia og internasjonalt. Vi har erfaring med eksternt samarbeid og kan kommunisere på norsk og engelsk.</p>
        </div>
        <div class="faq-item">
          <h3>Hva er deres designprosess?</h3>
          <p>Vi følger en strukturert 6-trinns prosess: Oppdagelse, Strategi, Design, Utvikling, Lansering og Support. Dette sikrer at vi leverer høykvalitetsresultater som oppfyller dine mål.</p>
        </div>
        <div class="faq-item">
          <h3>Tilbyr dere løpende støtte?</h3>
          <p>Absolutt! Vi tilbyr ulike vedlikeholds- og støttepakker for å sikre at nettstedet eller merkevaren din forblir oppdatert og fortsetter å yte optimalt.</p>
        </div>
        <div class="faq-item">
          <h3>Hva gjør dere annerledes?</h3>
          <p>Vi kombinerer kreativ fortreffelighet med strategisk tenkning. Hvert prosjekt behandles med friske øyne, og vi jobber som ekte partnere med våre klienter gjennom hele prosessen.</p>
        </div>
        <div class="faq-item">
          <h3>Kan jeg se mer av arbeidet deres?</h3>
          <p>Selvfølgelig! Sjekk ut vår <a href="/no/portfolio">porteføljeside</a> for å se våre nylige prosjekter. Vi kan også dele relevante case studies under vår konsultasjon.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 6rem 2rem 4rem;
    text-align: center;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .page-header p {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  /* Contact Section */
  .contact-section {
    background: var(--light-bg);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
  }

  /* Contact Form */
  .contact-form-container h2 {
    color: var(--primary-color);
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .form-intro {
    color: var(--dark-gray);
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .contact-form {
    background: white;
    padding: 2.5rem;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--primary-color);
    font-weight: 600;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 1rem;
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-color);
  }

  .form-group textarea {
    resize: vertical;
  }

  .checkbox-group label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
  }

  .checkbox-group input[type="checkbox"] {
    width: auto;
    cursor: pointer;
  }

  .btn-submit {
    width: 100%;
    padding: 1.25rem;
    font-size: 1.1rem;
  }

  .form-message {
    margin-top: 1rem;
    padding: 1rem;
    border-radius: 8px;
    text-align: center;
    display: none;
  }

  .form-message.success {
    background: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
    display: block;
  }

  .form-message.error {
    background: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
    display: block;
  }

  /* Contact Info */
  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
  }

  .info-card h3 {
    color: var(--primary-color);
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
    align-items: flex-start;
  }

  .info-item:last-child {
    margin-bottom: 0;
  }

  .info-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .info-item strong {
    display: block;
    color: var(--primary-color);
    margin-bottom: 0.25rem;
  }

  .info-item p {
    color: var(--dark-gray);
    margin: 0;
  }

  .info-item a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .info-item a:hover {
    text-decoration: underline;
  }

  .social-links-vertical {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: var(--light-bg);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-color);
    transition: all 0.3s;
  }

  .social-link:hover {
    background: var(--secondary-color);
    color: white;
    transform: translateX(5px);
  }

  .social-icon {
    font-size: 1.5rem;
  }

  .map-card {
    padding: 0;
    overflow: hidden;
    min-height: 250px;
  }

  .map-placeholder {
    width: 100%;
    height: 100%;
    min-height: 250px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .map-overlay {
    color: white;
    font-size: 1.25rem;
    text-align: center;
  }

  /* FAQ Section */
  .faq-section {
    background: white;
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 2rem;
  }

  .faq-item {
    padding: 2rem;
    background: var(--light-bg);
    border-radius: 15px;
    border-left: 4px solid var(--secondary-color);
  }

  .faq-item h3 {
    color: var(--primary-color);
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .faq-item p {
    color: var(--dark-gray);
    line-height: 1.6;
  }

  .faq-item a {
    color: var(--accent-color);
    text-decoration: none;
  }

  .faq-item a:hover {
    text-decoration: underline;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .page-header p {
      font-size: 1rem;
    }

    .contact-form {
      padding: 1.5rem;
    }

    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Form submission handling
  const contactForm = document.getElementById('contactForm');
  const formMessage = document.getElementById('formMessage');

  if (contactForm && formMessage) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      // Get form data
      const formData = new FormData(contactForm);
      const data = Object.fromEntries(formData);
      
      // Show loading state
      const submitBtn = contactForm.querySelector('.btn-submit');
      const originalText = submitBtn?.textContent;
      if (submitBtn) {
        submitBtn.textContent = 'Sender...';
        submitBtn.setAttribute('disabled', 'true');
      }
      
      // Simulate form submission (replace with actual API endpoint)
      setTimeout(() => {
        // Success message
        formMessage.textContent = 'Takk for meldingen! Vi tar kontakt innen 24 timer.';
        formMessage.className = 'form-message success';
        
        // Reset form
        contactForm.reset();
        
        // Reset button
        if (submitBtn && originalText) {
          submitBtn.textContent = originalText;
          submitBtn.removeAttribute('disabled');
        }
        
        // Hide message after 5 seconds
        setTimeout(() => {
          formMessage.style.display = 'none';
        }, 5000);
      }, 1000);
    });
  }
</script>
