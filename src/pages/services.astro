---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Our Services - Oslo Design Studio">
  <!-- Page Header -->
  <section class="page-header">
    <div class="container">
      <h1>Our Services</h1>
      <p>Comprehensive design solutions tailored to your business needs</p>
    </div>
  </section>

  <!-- Services Detail -->
  <section class="section services-detail">
    <div class="container">
      <div class="service-item">
        <div class="service-content">
          <div class="service-icon-large">🎨</div>
          <h2>Brand Identity & Strategy</h2>
          <p class="service-description">Your brand is more than just a logo—it's the complete experience your customers have with your business. We create cohesive brand identities that tell your story and connect with your audience.</p>
          <ul class="service-features">
            <li>Logo Design & Brand Guidelines</li>
            <li>Visual Identity Systems</li>
            <li>Brand Strategy & Positioning</li>
            <li>Print & Packaging Design</li>
            <li>Brand Refresh & Redesign</li>
          </ul>
          <div class="service-pricing">
            <strong>Starting from:</strong> 45,000 NOK
          </div>
        </div>
      </div>

      <div class="service-item reverse">
        <div class="service-content">
          <div class="service-icon-large">💻</div>
          <h2>Web Design & Development</h2>
          <p class="service-description">Beautiful, responsive websites that not only look stunning but also perform exceptionally. We combine aesthetics with functionality to create digital experiences that convert visitors into customers.</p>
          <ul class="service-features">
            <li>Custom Website Design</li>
            <li>Responsive & Mobile-First Development</li>
            <li>E-commerce Solutions</li>
            <li>Content Management Systems</li>
            <li>Website Maintenance & Support</li>
          </ul>
          <div class="service-pricing">
            <strong>Starting from:</strong> 35,000 NOK
          </div>
        </div>
      </div>

      <div class="service-item">
        <div class="service-content">
          <div class="service-icon-large">📱</div>
          <h2>UI/UX Design</h2>
          <p class="service-description">User experience is at the heart of everything we design. We create intuitive, engaging interfaces that make it easy for your users to achieve their goals while enjoying the journey.</p>
          <ul class="service-features">
            <li>User Research & Testing</li>
            <li>Information Architecture</li>
            <li>Wireframing & Prototyping</li>
            <li>Interface Design</li>
            <li>Usability Optimization</li>
          </ul>
          <div class="service-pricing">
            <strong>Starting from:</strong> 28,000 NOK
          </div>
        </div>
      </div>

      <div class="service-item reverse">
        <div class="service-content">
          <div class="service-icon-large">📊</div>
          <h2>Digital Marketing & Content</h2>
          <p class="service-description">Great design needs to be seen. We help amplify your brand's reach through strategic digital marketing campaigns and compelling content that engages and converts.</p>
          <ul class="service-features">
            <li>Social Media Graphics & Campaigns</li>
            <li>Content Strategy & Creation</li>
            <li>Email Marketing Design</li>
            <li>Digital Advertising</li>
            <li>Analytics & Performance Tracking</li>
          </ul>
          <div class="service-pricing">
            <strong>Starting from:</strong> 20,000 NOK/month
          </div>
        </div>
      </div>

      <div class="service-item">
        <div class="service-content">
          <div class="service-icon-large">🎬</div>
          <h2>Motion Graphics & Video</h2>
          <p class="service-description">Bring your brand to life with dynamic motion graphics and video content. From explainer videos to social media animations, we create visual stories that captivate.</p>
          <ul class="service-features">
            <li>Brand Animation & Motion Graphics</li>
            <li>Explainer Videos</li>
            <li>Social Media Video Content</li>
            <li>Product Demonstrations</li>
            <li>Video Editing & Post-Production</li>
          </ul>
          <div class="service-pricing">
            <strong>Starting from:</strong> 32,000 NOK
          </div>
        </div>
      </div>

      <div class="service-item reverse">
        <div class="service-content">
          <div class="service-icon-large">🚀</div>
          <h2>Consulting & Strategy</h2>
          <p class="service-description">Not sure where to start? Our design consultants can help you develop a comprehensive strategy that aligns your design efforts with your business goals.</p>
          <ul class="service-features">
            <li>Design Audits & Reviews</li>
            <li>Digital Strategy Planning</li>
            <li>Competitive Analysis</li>
            <li>Design System Development</li>
            <li>Workshop Facilitation</li>
          </ul>
          <div class="service-pricing">
            <strong>Hourly rate:</strong> 1,500 NOK/hour
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="section process-section">
    <div class="container">
      <h2 class="section-title">Our Process</h2>
      <div class="process-grid">
        <div class="process-step">
          <div class="step-number">01</div>
          <h3>Discovery</h3>
          <p>We start by understanding your business, goals, and target audience through in-depth research and consultation.</p>
        </div>
        <div class="process-step">
          <div class="step-number">02</div>
          <h3>Strategy</h3>
          <p>Based on our findings, we develop a comprehensive strategy that aligns design with your business objectives.</p>
        </div>
        <div class="process-step">
          <div class="step-number">03</div>
          <h3>Design</h3>
          <p>Our creative team brings the strategy to life with stunning visuals and intuitive user experiences.</p>
        </div>
        <div class="process-step">
          <div class="step-number">04</div>
          <h3>Development</h3>
          <p>We transform designs into functional, high-performance digital products using modern technologies.</p>
        </div>
        <div class="process-step">
          <div class="step-number">05</div>
          <h3>Launch</h3>
          <p>After thorough testing, we launch your project and ensure everything runs smoothly from day one.</p>
        </div>
        <div class="process-step">
          <div class="step-number">06</div>
          <h3>Support</h3>
          <p>Our relationship doesn't end at launch. We provide ongoing support to help your project succeed.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to Get Started?</h2>
      <p>Let's discuss how we can help bring your vision to life</p>
      <a href="/contact" class="btn">Request a Quote</a>
    </div>
  </section>
</Layout>

<style>
  .page-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 6rem 2rem 4rem;
    text-align: center;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .page-header p {
    font-size: 1.25rem;
    opacity: 0.9;
  }

  .services-detail {
    background: var(--light-bg);
  }

  .service-item {
    background: white;
    border-radius: 15px;
    padding: 3rem;
    margin-bottom: 3rem;
    box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .service-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.12);
  }

  .service-content {
    max-width: 800px;
  }

  .service-icon-large {
    font-size: 4rem;
    margin-bottom: 1.5rem;
  }

  .service-content h2 {
    color: var(--primary-color);
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .service-description {
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 2rem;
    color: var(--text-color);
  }

  .service-features {
    list-style: none;
    margin-bottom: 2rem;
  }

  .service-features li {
    padding: 0.75rem 0;
    padding-left: 2rem;
    position: relative;
    color: var(--text-color);
  }

  .service-features li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--secondary-color);
    font-weight: bold;
    font-size: 1.2rem;
  }

  .service-pricing {
    padding: 1.5rem;
    background: var(--light-bg);
    border-radius: 10px;
    border-left: 4px solid var(--secondary-color);
    font-size: 1.1rem;
  }

  .service-pricing strong {
    color: var(--primary-color);
  }

  /* Process Section */
  .process-section {
    background: white;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .process-step {
    text-align: center;
    padding: 2rem;
    background: var(--light-bg);
    border-radius: 10px;
    transition: transform 0.3s;
  }

  .process-step:hover {
    transform: translateY(-5px);
  }

  .step-number {
    font-size: 3rem;
    font-weight: bold;
    color: var(--secondary-color);
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .process-step h3 {
    color: var(--primary-color);
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .process-step p {
    color: var(--dark-gray);
    line-height: 1.6;
  }

  /* CTA Section */
  .cta-section {
    background: var(--primary-color);
    color: white;
    text-align: center;
    padding: 4rem 2rem;
  }

  .cta-section h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .cta-section p {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    opacity: 0.9;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .page-header p {
      font-size: 1rem;
    }

    .service-item {
      padding: 2rem;
    }

    .service-icon-large {
      font-size: 3rem;
    }

    .service-content h2 {
      font-size: 1.5rem;
    }

    .process-grid {
      grid-template-columns: 1fr;
    }

    .cta-section h2 {
      font-size: 2rem;
    }
  }
</style>
